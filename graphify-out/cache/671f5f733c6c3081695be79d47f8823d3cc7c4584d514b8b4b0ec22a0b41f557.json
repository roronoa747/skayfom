artId: cartIdCounter++\n        });\n    }\n    notify();\n}"},{"id":"model_updatequantity","label":"updateQuantity()","file_type":"code","source_file":"C:/Users/ilyas/Documents/skayfom/src/entities/cart/model.js","source_location":"L28-L37","layer":"base","provenance":[{"capability_id":"builtin:extract:javascript","stage":"extract","source_file":"C:/Users/ilyas/Documents/skayfom/src/entities/cart/model.js","source_location":"L28"}],"snippet":"export function updateQuantity(cartId, delta) {\n    const cartItem = cart.find(c => c.cartId === cartId);\n    if (!cartItem) return;\n    \n    cartItem.quantity += delta;\n    if (cartItem.quantity <= 0) {\n        cart = cart.filter(c => c.cartId !== cartId);\n    }\n    notify();\n}"},{"id":"model_removefromcart","label":"removeFromCart()","file_type":"code","source_file":"C:/Users/ilyas/Documents/skayfom/src/entities/cart/model.js","source_location":"L39-L42","layer":"base","provenance":[{"capability_id":"builtin:extract:javascript","stage":"extract","source_file":"C:/Users/ilyas/Documents/skayfom/src/entities/cart/model.js","source_location":"L39"}],"snippet":"export function removeFromCart(cartId) {\n    cart = cart.filter(c => c.cartId !== cartId);\n    notify();\n}"},{"id":"model_getcarttotal","label":"getCartTotal()","file_type":"code","source_file":"C:/Users/ilyas/Documents/skayfom/src/entities/cart/model.js","source_location":"L44-L46","layer":"base","provenance":[{"capability_id":"builtin:extract:javascript","stage":"extract","source_file":"C:/Users/ilyas/Documents/skayfom/src/entities/cart/model.js","source_location":"L44"}],"snippet":"export function getCartTotal() {\n    return cart.reduce((sum, current) => sum + (current.price * current.quantity), 0);\n}"},{"id":"model_getcartcount","label":"getCartCount()","file_type":"code","source_file":"C:/Users/ilyas/Documents/skayfom/src/entities/cart/model.js","source_location":"L48-L50","layer":"base","provenance":[{"capability_id":"builtin:extract:javascript","stage"