{
  "mcpServers": {
    "claude-flow": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "ruflo@latest",
        "mcp",
        "start"
      ],
      "env": {
        "npm_config_update_notifier": "false",
        "CLAUDE_FLOW_MODE": "v3",
        "CLAUDE_FLOW_HOOKS_ENABLED": "true",
        "CLAUDE_FLOW_TOPOLOGY": "hierarchical-mesh",
        "CLAUDE_FLOW_MAX_AGENTS": "15",
        "CLAUDE_FLOW_MEMORY_BACKEND": "hybrid"
      },
      "autoStart": false
    },
    "graphify-ts": {
      "command": "npx.cmd",
      "args": [
        "--yes",
        "@mohammednagy/graphify-ts@0.23.1",
        "serve",
        "--stdio",
        "C:\\Users\\ilyas\\Documents\\skayfom\\graphify-out\\graph.json"
      ],
      "env": {
        "GRAPHIFY_TOOL_PROFILE": "core"
      }
    }
  }
}
